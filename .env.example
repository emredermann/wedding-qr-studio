# =============================================================================
# Wedding QR — environment variables
# Copy to .env.local for local development and add the same keys to
# Vercel / Render → Project → Settings → Environment Variables.
# NEVER commit real values. See DEPLOYMENT.md for step-by-step setup.
# =============================================================================

# --- Supabase (free tier): Project Settings → API ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" / publishable key — browser-safe, only used for host sign-in.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key — SERVER ONLY. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Drive (OAuth2 refresh token — NOT a service account) -------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type "Desktop app"). Then run `npm run drive:token` to fill the last two.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Created for you by `npm run drive:token` (scope drive.file only sees
# folders the app itself created).
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- App ---------------------------------------------------------------------
# Signs guest cookies and upload tokens. Generate: openssl rand -hex 32
APP_SECRET=
# Optional: public URL of the deployment (used to allow the upload Origin when
# you serve the app from a custom domain behind a proxy).
NEXT_PUBLIC_APP_URL=
