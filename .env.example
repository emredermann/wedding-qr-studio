# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / publishable key (browser-safe; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key (server only; bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 -------------------------------------------------------------
# 32-char hex account id from the Cloudflare dashboard.
R2_ACCOUNT_ID=
# R2 API token with "Object Read & Write" scoped to the bucket below.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wedding-qr-media
# Public base URL for the bucket (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_URL=https://media.your-domain.com

# --- AI Categorization & Payments (Task 4) -------------------------------------
# OpenAI API key for gpt-4o-mini Vision moment classification.
OPENAI_API_KEY=
# Stripe Checkout & Webhook HMAC secret (falls back to signed local mode in dev).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
