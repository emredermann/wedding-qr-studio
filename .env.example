# =============================================================================
# Wedding QR — environment variables
# Copy to .env.local for local development and add the same keys to
# Vercel / Render → Project → Settings → Environment Variables.
# NEVER commit real values. See DEPLOYMENT.md for step-by-step setup.
# =============================================================================

# --- Supabase (free tier): Project Settings → API ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" / publishable key — browser-safe, only used for host sign-in.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key — SERVER ONLY. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth client (NOT a service account) — REQUIRED -------------------
# Google Cloud Console → Credentials → OAuth client ID, type "Web application",
# redirect URIs: https://<domain>/api/host/drive/callback,
#                http://localhost:3000/api/host/drive/callback
#                (+ http://127.0.0.1:53682/oauth2callback for `npm run drive:token`).
# Hosts use it for "Google Drive'ı bağla" (each host's media in their own Drive).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# --- Platform Drive — OPTIONAL (set both or neither) --------------------------
# Used for events whose host has NOT connected their own Drive. Leave both
# empty to require every host to connect. Filled by `npm run drive:token -- --write`.
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- App ---------------------------------------------------------------------
# Signs guest cookies/upload tokens and encrypts hosts' Google tokens at rest.
# Generate once and NEVER change it (connected Drives would need reconnecting):
#   openssl rand -hex 32
APP_SECRET=
# Optional: public URL of the deployment (used to allow the upload Origin when
# you serve the app from a custom domain behind a proxy).
NEXT_PUBLIC_APP_URL=
# Optional: header that carries the real client IP for rate limits/quotas when
# you run behind a proxy you trust, e.g. cf-connecting-ip (Cloudflare).
# Leave empty on Vercel (handled automatically) and Render (rightmost X-Forwarded-For).
TRUSTED_IP_HEADER=
